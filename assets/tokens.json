{
  "name": "Rosebrook RPG Goods",
  "source": "https://rosebrookrpggoods.com",
  "color": {
    "parchment": { "value": "#F0E6C8", "css": "--parchment", "role": "page / panel background" },
    "parchment-dk": { "value": "#DDD0A8", "css": "--parchment-dk", "role": "recessed / alt surface" },
    "leather": { "value": "#2C1A0E", "css": "--leather", "role": "deep UI chrome, headers" },
    "leather-mid": { "value": "#4A2E1A", "css": "--leather-mid", "role": "secondary chrome" },
    "gold": { "value": "#B8860B", "css": "--gold", "role": "primary accent / CTAs" },
    "gold-lt": { "value": "#D4A017", "css": "--gold-lt", "role": "hover / highlight gold" },
    "gold-pale": { "value": "#F0D080", "css": "--gold-pale", "role": "soft gold fills / borders" },
    "green": { "value": "#3D5A3E", "css": "--green", "role": "forest accent (success / nature)" },
    "crimson": { "value": "#8B2635", "css": "--crimson", "role": "alert / rare accent" },
    "ink": { "value": "#1A0F08", "css": "--ink", "role": "body text on parchment; nav chrome" }
  },
  "font": {
    "display": { "value": "Cinzel Decorative", "weights": [400, 700], "role": "hero lockups" },
    "title": { "value": "Cinzel", "weights": [400, 600, 900], "role": "headings, nav, buttons" },
    "body": { "value": "Crimson Text", "weights": [400, 600], "italic": true, "role": "long reading" }
  },
  "letterSpacing": {
    "cinzel": "0.12em",
    "cinzelWide": "0.14em",
    "eyebrow": "0.25em"
  },
  "radius": {
    "default": "2px"
  },
  "shadow": {
    "gold": "0 0 20px rgba(184,134,11,.5)",
    "goldSm": "0 0 14px rgba(184,134,11,.5)",
    "goldSoft": "0 0 16px rgba(184,134,11,.3)"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "2.5rem",
    "8": "3rem",
    "10": "4rem",
    "12": "5rem"
  }
}
